+#![cfg(not(target_arch = "wasm32"))]
+//! 단 구분선 설정(`setColumnSeparator`)과 `getColumnDef` 의 구분선 값, 그리고 쪽 맨 위에 매단
+//! 위아래 배치 표 아래에서 구분선을 시작하는 그리기.
+//!
+//! 한컴 한글 2024 의 쪽 그림(B4, 2단, 쪽 기준·위 정렬·오프셋 0 의 3행 8열 표, 바깥 여백
+//! 283HU)에서 표의 아래 테두리는 158px, 구분선의 첫 점은 162px 이다(971px 폭). 둘의 차는
+//! 표의 바깥 아래 여백(1mm, 3.8px)이고, 단의 글도 그 자리에서 시작한다.
+use rhwp::renderer::render_tree::{RenderNode, RenderNodeType};
+use rhwp::wasm_api::HwpDocument;
+
+const EIGHT_MM_COLUMN_GAP: i16 = 2268;
+const LINES: usize = 60;
+
+fn blank() -> HwpDocument {
+    let mut doc = HwpDocument::create_empty();
+    doc.create_blank_document().unwrap();
+    doc
+}
+
+fn fill_lines(doc: &mut HwpDocument, first_para: usize) {
+    for index in 0..LINES {
+        let para = first_para + index;
+        if index > 0 {
+            doc.insert_paragraph_native(0, para).unwrap();
+        }
+        doc.insert_text(
+            0,
+            para as u32,
+            0,
+            &format!("문항 {:03} 본문 한 줄", index + 1),
+        )
+        .unwrap();
+    }
+}
+
+fn two_columns_with_line(doc: &mut HwpDocument) {
+    doc.set_column_def_native(0, 2, 0, true, EIGHT_MM_COLUMN_GAP)
+        .unwrap();
+    doc.set_column_separator(0, r##"{"type":1,"width":1,"color":"#112233"}"##)
+        .unwrap();
+}
+
+fn json_field<'a>(json: &'a str, key: &str) -> &'a str {
+    let start = json.find(&format!("\"{}\":", key)).unwrap() + key.len() + 3;
+    let rest = &json[start..];
+    let end = rest.find([',', '}']).unwrap();
+    &rest[..end]
+}
+
+fn separator_fields(doc: &HwpDocument) -> (String, String, String) {
+    let json = doc.get_column_def(0).unwrap();
+    (
+        json_field(&json, "separatorType").to_string(),
+        json_field(&json, "separatorWidth").to_string(),
+        json_field(&json, "separatorColor").to_string(),
+    )
+}
+
+struct Page {
+    body_top: f64,
+    separators: Vec<(f64, f64, f64)>,
+    column_text_tops: Vec<f64>,
+    table_bottom: Option<f64>,
+}
+
+fn page(doc: &HwpDocument, page: u32) -> Page {
+    fn first_text_line_top(node: &RenderNode) -> Option<f64> {
+        if matches!(node.node_type, RenderNodeType::TextLine(_)) {
+            return Some(node.bbox.y);
+        }
+        node.children.iter().find_map(first_text_line_top)
+    }
+    fn walk(node: &RenderNode, out: &mut Page) {
+        match &node.node_type {
+            RenderNodeType::Body { .. } => {
+                out.body_top = node.bbox.y;
+                for child in &node.children {
+                    if let RenderNodeType::Line(line) = &child.node_type {
+                        if (line.x1 - line.x2).abs() < 0.01 {
+                            out.separators.push((line.x1, line.y1, line.y2));
+                        }
+                    }
+                }
+            }
+            RenderNodeType::Column(_) => {
+                out.column_text_tops
+                    .extend(node.children.iter().find_map(first_text_line_top));
+            }
+            RenderNodeType::Table(_) => {
+                out.table_bottom = Some(node.bbox.y + node.bbox.height);
+            }
+            _ => {}
+        }
+        for child in &node.children {
+            walk(child, out);
+        }
+    }
+    let mut out = Page {
+        body_top: 0.0,
+        separators: Vec::new(),
+        column_text_tops: Vec::new(),
+        table_bottom: None,
+    };
+    walk(&doc.build_page_render_tree(page).unwrap().root, &mut out);
+    out
+}
+
+#[test]
+fn the_line_set_is_reported_and_survives_hwp_and_hwpx() {
+    let mut doc = blank();
+    fill_lines(&mut doc, 0);
+    two_columns_with_line(&mut doc);
+    let set = ("1".to_string(), "1".to_string(), "\"#112233\"".to_string());
+    assert_eq!(separator_fields(&doc), set);
+
+    let hwp = HwpDocument::from_bytes(&doc.export_hwp_native().unwrap()).unwrap();
+    assert_eq!(separator_fields(&hwp), set, "after .hwp");
+    let hwpx = HwpDocument::from_bytes(&doc.export_hwpx_native().unwrap()).unwrap();
+    assert_eq!(separator_fields(&hwpx), set, "after HWPX");
+    assert_eq!(page(&hwpx, 0).separators.len(), 1, "HWPX draws the line");
+}
+
+#[test]
+fn type_zero_removes_the_line() {
+    let mut doc = blank();
+    fill_lines(&mut doc, 0);
+    two_columns_with_line(&mut doc);
+    assert_eq!(page(&doc, 0).separators.len(), 1);
+
+    doc.set_column_separator(0, r#"{"type":0}"#).unwrap();
+    assert_eq!(separator_fields(&doc).0, "0");
+    assert!(page(&doc, 0).separators.is_empty());
+    let hwpx = HwpDocument::from_bytes(&doc.export_hwpx_native().unwrap()).unwrap();
+    assert_eq!(separator_fields(&hwpx).0, "0", "no colLine after HWPX");
+}
+
+#[test]
+fn bad_values_are_refused_and_change_nothing() {
+    let mut doc = blank();
+    two_columns_with_line(&mut doc);
+    for json in [
+        r#"{"width":1}"#,
+        r#"{"type":8}"#,
+        r#"{"type":1,"width":16}"#,
+        r#"{"type":1,"color":"red"}"#,
+    ] {
+        assert!(doc.set_column_separator_native(0, json).is_err(), "{json}");
+    }
+    assert!(doc.set_column_separator_native(1, r#"{"type":1}"#).is_err());
+    assert_eq!(
+        separator_fields(&doc),
+        ("1".to_string(), "1".to_string(), "\"#112233\"".to_string())
+    );
+}
+
+#[test]
+fn without_a_head_object_the_line_runs_from_the_body_top_between_the_columns() {
+    let mut doc = blank();
+    fill_lines(&mut doc, 0);
+    two_columns_with_line(&mut doc);
+    let page = page(&doc, 0);
+    assert_eq!(page.separators.len(), 1);
+    let (_, top, bottom) = page.separators[0];
+    assert!(
+        (top - page.body_top).abs() < 0.01,
+        "{top} vs {}",
+        page.body_top
+    );
+    assert!(bottom > top);
+}
+
+/// The head of a test paper: a table hung from the top of the page body, pushing the text of
+/// both columns below it, set the way the editor's plugin sets it. Returns the paragraph
+/// after the table's and the table's outer bottom margin in px.
+fn head_table(doc: &mut HwpDocument) -> (usize, f64) {
+    let made = doc.create_table_native(0, 0, 0, 3, 8).unwrap();
+    let para: usize = json_field(&made, "paraIdx").parse().unwrap();
+    let control: u32 = json_field(&made, "controlIdx").parse().unwrap();
+    doc.set_table_properties_native(
+        0,
+        para,
+        control as usize,
+        r#"{"treatAsChar":false,"textWrap":"TopAndBottom","vertRelTo":"Page","horzRelTo":"Page","vertAlign":"Top","horzAlign":"Left","vertOffset":0,"horzOffset":0}"#,
+    )
+    .unwrap();
+    let props = doc.get_table_properties(0, para as u32, control).unwrap();
+    let outer_bottom: f64 = json_field(&props, "outerBottom").parse().unwrap();
+    (para + 1, outer_bottom * 96.0 / 7200.0)
+}
+
+#[test]
+fn below_a_table_hung_from_the_page_top_the_line_starts_where_the_columns_text_starts() {
+    let mut doc = blank();
+    let (first_line, outer_bottom) = head_table(&mut doc);
+    fill_lines(&mut doc, first_line);
+    two_columns_with_line(&mut doc);
+
+    let page = page(&doc, 0);
+    assert_eq!(page.separators.len(), 1);
+    let (_, top, _) = page.separators[0];
+    let table_bottom = page.table_bottom.expect("the head table is drawn");
+    assert_eq!(page.column_text_tops.len(), 2, "both columns hold text");
+    for text_top in &page.column_text_tops {
+        assert!(
+            (top - text_top).abs() < 0.01,
+            "line {top}, column text {text_top}"
+        );
+    }
+    assert!(
+        (top - (table_bottom + outer_bottom)).abs() < 0.01,
+        "line {top}, table foot {table_bottom}, outer bottom margin {outer_bottom}"
+    );
+}
+
+#[test]
+fn a_page_without_the_head_object_keeps_the_line_from_the_body_top() {
+    let mut doc = blank();
+    let (first_line, _) = head_table(&mut doc);
+    fill_lines(&mut doc, first_line);
+    for index in 0..LINES {
+        let para = first_line + LINES + index;
+        doc.insert_paragraph_native(0, para).unwrap();
+        doc.insert_text(0, para as u32, 0, &format!("둘째 쪽 {:03}", index + 1))
+            .unwrap();
+    }
+    two_columns_with_line(&mut doc);
+    assert!(doc.page_count() >= 2);
+
+    let second = page(&doc, 1);
+    assert!(second.table_bottom.is_none());
+    assert_eq!(second.separators.len(), 1);
+    let (_, top, _) = second.separators[0];
+    assert!(
+        (top - second.body_top).abs() < 0.01,
+        "{top} vs {}",
+        second.body_top
+    );
+}
