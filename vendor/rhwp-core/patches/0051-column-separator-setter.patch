+    /// 단 구분선 설정 (`{"type":u8,"width":u8,"color":"#rrggbb"}`, type 0 = 선 없음)
+    ///
+    /// `set_column_def_native` 가 고치는 구역의 첫 ColumnDef 에 구분선 종류·굵기·색을
+    /// 쓴다. 없으면 첫 문단에 한 단짜리 ColumnDef 를 만든다. 종류는 HWPX `colLine` 이
+    /// 되돌려 읽는 0~7, 굵기는 선 굵기 표의 0~15 만 받는다. width·color 를 빼면 그 값은
+    /// 그대로 둔다.
+    pub fn set_column_separator_native(
+        &mut self,
+        section_idx: usize,
+        json: &str,
+    ) -> Result<String, HwpError> {
+        use super::super::helpers::{json_color, json_str, json_u32};
+        use crate::model::page::ColumnDirection;
+
+        if section_idx >= self.document.sections.len() {
+            return Err(HwpError::RenderError(format!(
+                "구역 인덱스 {} 범위 초과",
+                section_idx
+            )));
+        }
+        let line_type = json_u32(json, "type")
+            .filter(|t| *t <= 7)
+            .ok_or_else(|| HwpError::RenderError("type 은 0~7 이어야 합니다".to_string()))?
+            as u8;
+        let width = match json_u32(json, "width") {
+            Some(w) if w <= 15 => Some(w as u8),
+            Some(_) => {
+                return Err(HwpError::RenderError(
+                    "width 는 0~15 이어야 합니다".to_string(),
+                ))
+            }
+            None => None,
+        };
+        let color = match json_str(json, "color") {
+            Some(_) => Some(json_color(json, "color").ok_or_else(|| {
+                HwpError::RenderError("color 는 #rrggbb 이어야 합니다".to_string())
+            })?),
+            None => None,
+        };
+
+        let paragraphs = &mut self.document.sections[section_idx].paragraphs;
+        if paragraphs.is_empty() {
+            return Err(HwpError::RenderError("구역에 문단이 없습니다".to_string()));
+        }
+        let has_column_def = paragraphs
+            .iter()
+            .flat_map(|para| para.controls.iter())
+            .any(|ctrl| matches!(ctrl, Control::ColumnDef(_)));
+        if !has_column_def {
+            paragraphs[0].controls.push(Control::ColumnDef(ColumnDef {
+                column_count: 1,
+                same_width: true,
+                direction: ColumnDirection::LeftToRight,
+                ..Default::default()
+            }));
+        }
+        for ctrl in paragraphs
+            .iter_mut()
+            .flat_map(|para| para.controls.iter_mut())
+        {
+            if let Control::ColumnDef(cd) = ctrl {
+                cd.separator_type = line_type;
+                if let Some(width) = width {
+                    cd.separator_width = width;
+                }
+                if let Some(color) = color {
+                    cd.separator_color = color;
+                }
+                break;
+            }
+        }
+
+        self.document.sections[section_idx].raw_stream = None;
+        self.rebuild_section(section_idx);
+
+        Ok("{\"ok\":true}".to_string())
+    }
+
